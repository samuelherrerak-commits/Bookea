# URL de la implementación "Aplicación web" del Apps Script (termina en /exec).
# Si la dejas vacía, la app corre en modo demo con datos de ejemplo.
VITE_API_URL=

# Token que el Apps Script exige en cada petición.
VITE_API_TOKEN=Bookeav1.1.1

# Número de WhatsApp (solo dígitos, con código de país). La hoja Configuracion
# puede sobreescribirlo con la clave "whatsapp".
VITE_WHATSAPP=584122516390
