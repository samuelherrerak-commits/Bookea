# URL de la implementación "Aplicación web" del Apps Script (termina en /exec).
# Si la dejas vacía, la app corre en modo demo con datos de ejemplo.
VITE_API_URL=

# Token que el Apps Script exige en cada petición (menú "Generar token de la API"
# del script maestro). No lo subas al repo: en Render se carga en Environment.
VITE_API_TOKEN=

# Número de WhatsApp (solo dígitos, con código de país). La hoja Configuracion
# puede sobreescribirlo con la clave "whatsapp".
VITE_WHATSAPP=584122516390
# WhatsApp de bookeaa para la landing (consultas y prueba gratis).
VITE_BOOKEAA_WHATSAPP=584220298203

# Negocio al que entra quien abre la raíz del dominio sin /u/<slug> en la URL.
# Cada negocio tiene su propio enlace /u/su-negocio; esto solo define la raíz.
VITE_DEFAULT_SHOP=samuel-herrera
